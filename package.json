{
  "name": "community-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Community crawler for rental market pain point analysis",
  "scripts": {
    "start": "tsx src/cli.ts",
    "crawl": "tsx src/cli.ts",
    "crawl:dated": "tsx src/cli.ts --site=${SITES:-fmkorea,clien,arca,dcinside} --keyword=\"${KEYWORD:-정수기 렌탈}\" --sort=${SORT:-latest} --until-date=${UNTIL_DATE:-2025-01-01} --pages=${PAGES:-20} --max-posts=${MAX_POSTS:-100} --delay-ms=${DELAY_MS:-300} --output=\"${OUTPUT:-output/keyword-dated.csv}\"",
    "crawl:help": "tsx src/cli.ts --help",
    "crawl:limit": "tsx src/cli.ts --site=${SITES:-fmkorea,clien,arca,dcinside} --keyword=\"${KEYWORD:-정수기 렌탈}\" --sort=${SORT:-latest} --no-cutoff --pages=${PAGES:-20} --max-posts=${MAX_POSTS:-100} --delay-ms=${DELAY_MS:-300} --output=\"${OUTPUT:-output/keyword-limit.csv}\"",
    "crawl:smoke": "tsx src/cli.ts --site=dcinside --keyword=\"정수기 렌탈\" --sort=latest --no-cutoff --pages=1 --delay-ms=0 --output=output/smoke.csv",
    "check": "npm run typecheck && npm test",
    "ci": "npm run validate",
    "clean": "rm -rf dist",
    "clean:output": "find output -maxdepth 1 -type f \\( -name '*smoke*.csv' -o -name '*test*.csv' -o -name '*테스트*.csv' \\) -delete",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "test:watch": "tsx --test --watch src/*.test.ts src/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "npm run clean && npm run check && npm run build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "csv-stringify": "^6.7.0",
    "dayjs": "^1.11.20",
    "playwright-core": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
